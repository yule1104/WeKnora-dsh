.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f8faf9 0%, #f3f3f3 100%);
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e7ebf0;
}

.chat-header-text {
  flex: 1;
  min-width: 0;
}

.chat-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.new-chat {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding: 12rpx 24rpx;
  border: 1rpx solid #b8ebcc;
  border-radius: 999rpx;
  color: #07c05f;
  font-size: 26rpx;
}

.new-chat-disabled {
  color: #b5b5b5;
  border-color: #e0e0e0;
}

.chat-list {
  flex: 1;
  height: 0;
  box-sizing: border-box;
  padding: 24rpx 32rpx 0;
}

.chat-empty {
  margin-top: 120rpx;
  text-align: center;
  color: rgba(0, 0, 0, 0.45);
  font-size: 26rpx;
  line-height: 1.6;
}

.bubble-row {
  display: flex;
  margin-bottom: 24rpx;
}

.bubble-row-user {
  justify-content: flex-end;
}

.bubble-row-assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 82%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-word;
}

.bubble-user {
  background: #07c05f;
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
}

.bubble-assistant {
  max-width: 100%;
  background: #ffffff;
  color: #1a1a1a;
  border: 1rpx solid #e7ebf0;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 192, 95, 0.06);
}

.bubble-error {
  color: #c0392b;
  border-color: #f3c7c1;
  background: #fff6f5;
}

.bubble-text {
  white-space: pre-wrap;
}

.bubble-md {
  display: block;
  font-size: 28rpx;
  line-height: 1.75;
  color: #1a1a1a;
}

.bubble-pending {
  color: rgba(0, 0, 0, 0.45);
}

.cursor {
  display: inline-block;
  width: 14rpx;
  height: 28rpx;
  margin-left: 4rpx;
  vertical-align: middle;
  background: #07c05f;
  animation: blink 1s steps(1) infinite;
}

@keyframes blink {
  50% {
    opacity: 0;
  }
}

.chat-list-bottom {
  height: 24rpx;
}

.composer {
  display: flex;
  align-items: flex-end;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #e7ebf0;
}

.composer-input {
  flex: 1;
  min-height: 80rpx;
  max-height: 240rpx;
  padding: 18rpx 24rpx;
}

.composer-send {
  flex-shrink: 0;
  width: 140rpx !important;
  height: 80rpx;
  margin: 0 0 0 16rpx;
  padding: 0;
  line-height: 80rpx;
  font-size: 28rpx;
}
