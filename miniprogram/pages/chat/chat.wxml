<view class="chat-page">
  <view class="chat-header">
    <view class="chat-header-text">
      <view class="chat-title">{{chatTitle}}</view>
      <view class="muted">{{chatSubtitle}}</view>
    </view>
    <view
      class="new-chat {{loading || !messages.length ? 'new-chat-disabled' : ''}}"
      bindtap="newChat"
    >{{newChatText}}</view>
  </view>

  <scroll-view class="chat-list" scroll-y scroll-top="{{scrollTop}}" scroll-with-animation>
    <view wx:if="{{!messages.length}}" class="chat-empty">{{emptyChatText}}</view>

    <view
      wx:for="{{messages}}"
      wx:key="id"
      class="bubble-row {{item.role === 'user' ? 'bubble-row-user' : 'bubble-row-assistant'}}"
    >
      <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-assistant'}} {{item.status === 'error' ? 'bubble-error' : ''}}">
        <rich-text
          wx:if="{{item.role === 'assistant' && item.status !== 'error' && item.nodes.length}}"
          class="bubble-md"
          nodes="{{item.nodes}}"
          user-select
        ></rich-text>
        <text wx:elif="{{item.content}}" class="bubble-text" user-select>{{item.content}}</text>
        <text wx:elif="{{item.status === 'streaming'}}" class="bubble-pending">{{generatingText}}</text>
        <view wx:if="{{item.status === 'streaming' && item.content}}" class="cursor"></view>
      </view>
    </view>

    <view class="chat-list-bottom"></view>
  </scroll-view>

  <view class="composer">
    <textarea
      class="composer-input"
      value="{{query}}"
      placeholder="{{questionPlaceholder}}"
      bindinput="onQueryInput"
      auto-height
      maxlength="2000"
      cursor-spacing="24"
      disabled="{{loading}}"
    />
    <button
      class="composer-send"
      bindtap="ask"
      loading="{{loading}}"
      disabled="{{loading || !query}}"
    >{{sendText}}</button>
  </view>
</view>
